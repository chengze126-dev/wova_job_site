# Local development uses a file SQLite database.
DATABASE_URL="file:./dev.db"
# Production (Vercel) needs a free hosted SQLite database from Turso:
# 1. Sign up at https://turso.tech
# 2. Create a database named wova
# 3. Copy the URL and token into Vercel → Settings → Environment Variables
#    TURSO_DATABASE_URL=libsql://wova-YOURORG.turso.io
#    TURSO_AUTH_TOKEN=...
# Do not leave production on local SQLite — Vercel disk is temporary and data will vanish.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
AUTH_SECRET="replace-with-a-long-random-string"
# Local: http://localhost:3000
# Vercel production: https://www.wova.cc (do not leave this as localhost on Vercel)
AUTH_URL="http://localhost:3000"
# Email verification and password reset (Resend). Required in production.
# 1. Create a Resend API key
# 2. Verify the wova.cc domain in Resend
# 3. Set EMAIL_FROM to a verified address (not @resend.dev — that only mails the Resend account owner)
RESEND_API_KEY=""
EMAIL_FROM="Wova <noreply@wova.cc>"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
ADMIN_EMAIL="demarsgold@gmail.com"
# Admin login. If unset, the app uses Passion19991206@
ADMIN_PASSWORD="Passion19991206@"
# Social login. Callback URLs:
# https://www.wova.cc/api/auth/oauth/github/callback
# https://www.wova.cc/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
