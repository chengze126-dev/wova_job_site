DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
# Local: http://localhost:3000
# Vercel production: https://www.wova.cc (do not leave this as localhost on Vercel)
AUTH_URL="http://localhost:3000"
# Email verification and password reset (Resend). Required in production.
# 1. Create a Resend API key
# 2. Verify the wova.cc domain in Resend
# 3. Set EMAIL_FROM to a verified address (not @resend.dev — that only mails the Resend account owner)
RESEND_API_KEY=""
EMAIL_FROM="Wova <noreply@wova.cc>"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
ADMIN_EMAIL="demarsgold@gmail.com"
# Required in production. Sets the admin login password on first boot.
ADMIN_PASSWORD=""
# Social login (optional). Callback URL for each: https://www.wova.cc/api/auth/oauth/{github|linkedin|google}/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
